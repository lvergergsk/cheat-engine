;
; iRpsmmkfOYytqJFB64.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=iRpsmmkfOYytqJFB64.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages

[DestinationDirs]
DefaultDestDir = 12
iRpsmmkfOYytqJFB64_Device_CoInstaller_CopyFiles = 11

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
iRpsmmkfOYytqJFB64.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%iRpsmmkfOYytqJFB64.DeviceDesc%=iRpsmmkfOYytqJFB64_Device, Root\iRpsmmkfOYytqJFB64 ; TODO: edit hw-id

[iRpsmmkfOYytqJFB64_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
iRpsmmkfOYytqJFB64.sys

;-------------- Service installation
[iRpsmmkfOYytqJFB64_Device.NT.Services]
AddService = iRpsmmkfOYytqJFB64,%SPSVCINST_ASSOCSERVICE%, iRpsmmkfOYytqJFB64_Service_Inst

; -------------- iRpsmmkfOYytqJFB64 driver install sections
[iRpsmmkfOYytqJFB64_Service_Inst]
DisplayName    = %iRpsmmkfOYytqJFB64.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\iRpsmmkfOYytqJFB64.sys

;
;--- iRpsmmkfOYytqJFB64_Device Coinstaller installation ------
;

[iRpsmmkfOYytqJFB64_Device.NT.CoInstallers]
AddReg=iRpsmmkfOYytqJFB64_Device_CoInstaller_AddReg
CopyFiles=iRpsmmkfOYytqJFB64_Device_CoInstaller_CopyFiles

[iRpsmmkfOYytqJFB64_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[iRpsmmkfOYytqJFB64_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[iRpsmmkfOYytqJFB64_Device.NT.Wdf]
KmdfService =  iRpsmmkfOYytqJFB64, iRpsmmkfOYytqJFB64_wdfsect
[iRpsmmkfOYytqJFB64_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="iRpsmmkfOYytqJFB64" ;TODO: Replace with your manufacturer name
ClassName="System" ; TODO: edit ClassName
DiskName = "iRpsmmkfOYytqJFB64 Installation Disk"
iRpsmmkfOYytqJFB64.DeviceDesc = "iRpsmmkfOYytqJFB64 Device"
iRpsmmkfOYytqJFB64.SVCDESC = "iRpsmmkfOYytqJFB64 Service"
