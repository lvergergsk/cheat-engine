;
; KlYRlJhbFwPbilWb64.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=KlYRlJhbFwPbilWb64.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12
KlYRlJhbFwPbilWb64_Device_CoInstaller_CopyFiles = 11

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
KlYRlJhbFwPbilWb64.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%KlYRlJhbFwPbilWb64.DeviceDesc%=KlYRlJhbFwPbilWb64_Device, Root\KlYRlJhbFwPbilWb64 ; TODO: edit hw-id

[KlYRlJhbFwPbilWb64_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
KlYRlJhbFwPbilWb64.sys

;-------------- Service installation
[KlYRlJhbFwPbilWb64_Device.NT.Services]
AddService = KlYRlJhbFwPbilWb64,%SPSVCINST_ASSOCSERVICE%, KlYRlJhbFwPbilWb64_Service_Inst

; -------------- KlYRlJhbFwPbilWb64 driver install sections
[KlYRlJhbFwPbilWb64_Service_Inst]
DisplayName    = %KlYRlJhbFwPbilWb64.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\KlYRlJhbFwPbilWb64.sys

;
;--- KlYRlJhbFwPbilWb64_Device Coinstaller installation ------
;

[KlYRlJhbFwPbilWb64_Device.NT.CoInstallers]
AddReg=KlYRlJhbFwPbilWb64_Device_CoInstaller_AddReg
CopyFiles=KlYRlJhbFwPbilWb64_Device_CoInstaller_CopyFiles

[KlYRlJhbFwPbilWb64_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[KlYRlJhbFwPbilWb64_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[KlYRlJhbFwPbilWb64_Device.NT.Wdf]
KmdfService =  KlYRlJhbFwPbilWb64, KlYRlJhbFwPbilWb64_wdfsect
[KlYRlJhbFwPbilWb64_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="KlYRlJhbFwPbilWb64" ;TODO: Replace with your manufacturer name
ClassName="System" ; TODO: edit ClassName
DiskName = "KlYRlJhbFwPbilWb64 Installation Disk"
KlYRlJhbFwPbilWb64.DeviceDesc = "KlYRlJhbFwPbilWb64 Device"
KlYRlJhbFwPbilWb64.SVCDESC = "KlYRlJhbFwPbilWb64 Service"
